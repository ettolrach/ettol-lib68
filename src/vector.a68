module Vector =
def
    { Algol doesn't have ways of generic programming, so the consumer of this code needs to replace
      "int" with whatever type they would like to use. if you need many types, use a union! e.g.
      union(bool, ref string, []int) }
    pub mode Element = int;

    pub mode Vec = struct (ref []Element row, int len);

    pub proc vec_new = Vec: (heap [1:0]Element, 0);
    pub proc vec_with_capacity = (int size) Vec: (heap [1:(size >= 0 | size | 0)]Element, 0);

    pub op +:= = (ref Vec v, Element e) void:
        begin
              if len of v = UPB (row of v)
              then begin
                    int new_upb = if len of v < 2 then 2 else len of v * 2 fi;
                    ref []Element new_row = heap [1:new_upb]Element;
                    new_row[1:len of v] := (row of v)[1:len of v];
                    row of v := new_row
              end
              fi;
              len of v +:= 1;
              (row of v)[len of v] := e
        end;

    { in Algol, modules are executable code, so without putting "skip" here, the compiler is
      expecting us to provide some code to run. like Python. unlike Python, we can't omit "skip". }
    skip
fed
